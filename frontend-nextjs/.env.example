DATABASE_URL=
# Origen exacto del portal; HTTPS en producción
APP_URL=http://localhost:3000
# Clave de cuenta sk_test_... para pruebas; sk_live_... para producción
RECURRENTE_SECRET_KEY=
# Signing secret del webhook de este mismo ambiente
RECURRENTE_WEBHOOK_SECRET=

# Solo para npm run admin:create. Contraseña de 14 caracteres o más.
OKTAE_ADMIN_EMAIL=
OKTAE_ADMIN_PASSWORD=

# Misma clave en el CRM y la credencial Header Auth de n8n
CRM_MESSENGER_SYNC_TOKEN=

# WhatsApp: completar directamente, no compartir las claves por chat.
# App Secret de ChatOktae (Meta > App settings > Basic)
META_APP_SECRET=
# Clave aleatoria de 32 bytes en hexadecimal. No rotar sin recifrar conexiones.
WHATSAPP_ENCRYPTION_KEY=
# Otro secreto aleatorio (32 caracteres mínimo) para validar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=

# Mantener false hasta preparar la sincronización de coexistencia y n8n.
WHATSAPP_ONBOARDING_ENABLED=false
