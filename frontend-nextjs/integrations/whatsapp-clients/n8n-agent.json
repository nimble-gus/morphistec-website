          "name": "Anthropic account"
        }
      }
    },
    {
      "id": "f3213fc1-15c6-4f49-8242-aa1bb6b10fc9",
      "name": "Validar respuesta del negocio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        100
      ],
      "parameters": {
        "jsCode": "let raw=$input.first().json.output;\nif(typeof raw!=='string'||raw.length>15000)throw new Error('Salida inválida');\nraw=raw.trim().replace(/^```(?:json)?\\s*/,'').replace(/\\s*```$/,'');\nconst a=JSON.parse(raw);\nif(typeof a.reply!=='string'||!a.reply.trim()||a.reply.length>1500)throw new Error('Respuesta inválida');\nreturn [{json:{protocol:'oktae_clients_v1',reply:a.reply,qualification:a.qualification||{},summary:typeof a.summary==='string'?a.summary.slice(0,1500):''}}];"
      }
    },
    {
      "id": "a255e685-1301-4a89-9f54-5c575b4238f5",
      "name": "Responder al portal privado",
