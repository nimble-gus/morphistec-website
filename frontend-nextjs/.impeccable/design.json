  "narrative": {
    "northStar": "Agenda operativa de Oktae",
    "overview": "This is a descriptive name for the built /admin interface, not evidence of an approved concept exercise. The private workspace inherits Poppins, charcoal framing, indigo actions, and the amber punctuation of the Oktae wordmark. White working surfaces and a pale canvas support sustained reading and editing.\n\nThe system is compact, restrained, and explicit: contacts use rows, details use a bordered panel, and labels describe the action or state in Spanish. This document records only the private CRM; the public site's darker, pill-shaped components remain a separate incumbent system.",
    "keyCharacteristics": [
      "Charcoal navigation surrounding a light workspace.",
      "Indigo actions and selection, with text-bearing semantic status badges.",
      "Flat bordered containers and modestly rounded controls.",
      "One Poppins family with a compact hierarchy."
    ],
    "rules": [
      {
        "name": "The State Has a Name Rule.",
        "body": "Preserve visible status text alongside its color, especially when distinguishing a generated link from a paid transaction.",
        "section": "colors"
      },
      {
        "name": "The Selection Keeps Context Rule.",
        "body": "Keep list and detail side by side when space supports both; in the single-panel layout, retain the explicit return to prospects.",
        "section": "layout"
      },
      {
        "name": "The Bordered Workspace Rule.",
        "body": "Use the established surface, divider, and selection treatments to express grouping and state.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use charcoal framing, light working surfaces, and indigo action emphasis within the CRM.",
      "Do preserve visible labels, keyboard focus, and explicit status names.",
      "Do keep detail return navigation available when the list is hidden.",
      "Do keep configuration and payment state messages precise in Spanish."
    ],
    "donts": [
      "Don't communicate payment confirmation through color alone.",
      "Don't treat a generated checkout link as a received payment.",
      "Don't inherit the public site's pill controls or serif display treatment into this recorded CRM without a deliberate design change."
    ]
  }
}
